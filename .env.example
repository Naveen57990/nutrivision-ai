# ==========================================
# NutriVision Environment Configuration
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=replace-with-a-very-long-random-secret-key-for-jwt-signing

# Database Connection (SQLite default for dev; PostgreSQL for production)
DATABASE_URL=sqlite:///./nutrivision.db
# DATABASE_URL=postgresql://user:password@localhost:5432/nutrivision

# AI & Vision Providers (Optional - App runs seamlessly in Demo Mode if absent)
GEMINI_API_KEY=
OPENAI_API_KEY=
DEMO_MODE=True

# Frontend URL Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
